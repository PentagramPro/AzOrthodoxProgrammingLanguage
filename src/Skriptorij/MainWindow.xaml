<Window x:Class="Skriptorij.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Скрипторїй" Width="1400" Height="900" MinWidth="700" MinHeight="450"
        Icon="Assets/cross.ico" Background="#F2F2F2"
        FontFamily="{StaticResource Slav}" FontSize="15"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <DockPanel>
        <!-- строка меню -->
        <Menu x:Name="MainMenu" DockPanel.Dock="Top" FontSize="17" Padding="4,1"
              FontFamily="{StaticResource Slav}">
            <Menu.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FBFBFB" Offset="0"/>
                    <GradientStop Color="#ECECEC" Offset="1"/>
                </LinearGradientBrush>
            </Menu.Background>
        </Menu>

        <!-- иконостасъ -->
        <Border x:Name="IconoBar" DockPanel.Dock="Top" BorderBrush="{StaticResource Gold}" BorderThickness="0,0,0,3">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#5A1E12" Offset="0"/>
                    <GradientStop Color="#3D140B" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="Iconostasis" Orientation="Horizontal" Margin="5"/>
            </ScrollViewer>
        </Border>

        <!-- хлѣбныя крошки -->
        <Border DockPanel.Dock="Top" Background="#F7F7F7" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" Padding="6,2">
            <StackPanel x:Name="Crumbs" Orientation="Horizontal" MinHeight="22"/>
        </Border>

        <!-- строка состоянія -->
        <StatusBar DockPanel.Dock="Bottom" Background="#E9E9E9" FontFamily="{StaticResource Slav}" FontSize="14">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate><DockPanel LastChildFill="True"/></ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem DockPanel.Dock="Right"><TextBlock x:Name="LangText" Text="А҆́зъ"/></StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right"><TextBlock Text="UTF-8" Margin="10,0"/></StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right"><TextBlock x:Name="PosText" Margin="10,0"/></StatusBarItem>
            <StatusBarItem><TextBlock x:Name="StatusText" Text="Бл҃гослове́нъ гдⷭ҇ь." TextTrimming="CharacterEllipsis"/></StatusBarItem>
        </StatusBar>

        <Grid x:Name="MainGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="120"/>
                <RowDefinition Height="4"/>
                <RowDefinition x:Name="BottomRow" Height="210" MinHeight="0"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition x:Name="ProjectCol" Width="290" MinWidth="0"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- боковая полоса -->
                <Border Grid.Column="0" Background="#E6E6E6" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,1,0">
                    <Border x:Name="ProjectStripTab" VerticalAlignment="Top" Background="#CFD8E6" Padding="2,10" Cursor="Hand">
                        <TextBlock Text="☦ 1: Проектъ" FontSize="14">
                            <TextBlock.LayoutTransform><RotateTransform Angle="-90"/></TextBlock.LayoutTransform>
                        </TextBlock>
                    </Border>
                </Border>

                <!-- проектъ -->
                <DockPanel Grid.Column="1" Background="White">
                    <Border DockPanel.Dock="Top" Background="{StaticResource HeadBrush}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" Padding="6,2">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="NewFileBtn" Content="✚" ToolTip="Но́вый фа́йлъ" Style="{StaticResource ToolBtn}"/>
                                <Button x:Name="RefreshBtn" Content="⟳" ToolTip="Ѡ҆бнови́ти дре́во" Style="{StaticResource ToolBtn}"/>
                            </StackPanel>
                            <TextBlock FontSize="16" VerticalAlignment="Center"><Run Text="П" Foreground="{StaticResource Cinnabar}"/><Run Text="роектъ"/></TextBlock>
                        </DockPanel>
                    </Border>
                    <TreeView x:Name="Tree" BorderThickness="0" FontSize="16" Padding="0,3"/>
                </DockPanel>
                <GridSplitter Grid.Column="2" HorizontalAlignment="Stretch" Background="{StaticResource PanelBorder}"/>

                <!-- редакторъ -->
                <DockPanel Grid.Column="3" Background="White">
                    <Border DockPanel.Dock="Top" Background="#E4E4E4" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" Padding="2,2,2,0">
                        <WrapPanel x:Name="TabStrip"/>
                    </Border>
                    <Border x:Name="KbdBar" DockPanel.Dock="Top" Background="#FAF6EA" BorderBrush="#E3D9BD" BorderThickness="0,0,0,1" Padding="4,1">
                        <WrapPanel x:Name="Kbd"/>
                    </Border>
                    <Grid x:Name="EditorHost">
                        <StackPanel x:Name="Welcome" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="☦" FontSize="84" Foreground="{StaticResource Gold}" HorizontalAlignment="Center" FontFamily="Segoe UI Symbol"/>
                            <TextBlock Text="Скрипторїй" FontSize="42" Foreground="{StaticResource Cinnabar}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Среда́ для пи́санїѧ на ꙗ҆зы́цѣ А҆́зъ." FontSize="17" HorizontalAlignment="Center" Margin="0,6"/>
                            <TextBlock Foreground="#7A7A7A" HorizontalAlignment="Center" TextAlignment="Center"
                                       Text="Избери́ фа́йлъ въ дре́вѣ проекта сле́ва.&#10;Ctrl+S — сохрани́ти · Ctrl+F9 — собра́ти · Shift+F10 — пꙋсти́ти"/>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Grid>

            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{StaticResource PanelBorder}"/>

            <!-- исходъ -->
            <DockPanel Grid.Row="2" x:Name="BottomPanel" Background="White">
                <Border DockPanel.Dock="Top" Background="{StaticResource HeadBrush}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" Padding="6,2">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="RunBtn" Content="▶ Пꙋсти́ти" ToolTip="Shift+F10" Style="{StaticResource ToolBtn}"/>
                            <Button x:Name="StopBtn" Content="■ Ѡ҆станови́ти" Style="{StaticResource ToolBtn}" IsEnabled="False"/>
                            <Button x:Name="BuildBtn" Content="⚒ Собра́ти" ToolTip="Ctrl+F9" Style="{StaticResource ToolBtn}"/>
                            <Button x:Name="ConsoleBtn" Content="▣ Въ консо́ли" ToolTip="Ctrl+Shift+F10" Style="{StaticResource ToolBtn}"/>
                            <Button x:Name="ClearBtn" Content="✕" ToolTip="Ѡ҆чи́стити" Style="{StaticResource ToolBtn}"/>
                        </StackPanel>
                        <TextBlock Text="☦ Исхо́дъ" FontSize="16" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>
                    <RichTextBox x:Name="Output" IsReadOnly="True" IsDocumentEnabled="True" BorderThickness="0"
                                 FontSize="17" VerticalScrollBarVisibility="Auto" Padding="6,4">
                        <FlowDocument PagePadding="0" LineHeight="1"/>
                    </RichTextBox>
                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{StaticResource PanelBorder}"/>
                    <DockPanel Grid.Column="2" Margin="4">
                        <TextBlock DockPanel.Dock="Top" FontSize="14" Margin="0,0,0,3">Вво́дъ для <Italic>внемлѝ()</Italic>:</TextBlock>
                        <TextBox x:Name="StdinBox" AcceptsReturn="True" FontSize="16" VerticalScrollBarVisibility="Auto"
                                 ToolTip="по строкѣ на ка́ждый вопро́съ"/>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
